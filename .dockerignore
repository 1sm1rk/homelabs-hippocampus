# The image build uses the PARENT projects/ directory as its context (see the
# Dockerfile), so the rules that apply there live in projects/.dockerignore.
# This file only matters when this repo itself is used as the context root:
# prune build output, VCS/IDE metadata and deployment data.
.git
.gitignore
Dockerfile
.dockerignore
**/target/
.settings/
.classpath
.project
.idea/
*.iml
models/
.env
AGENTS.md
README.md
